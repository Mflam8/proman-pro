{
  "name": "Analyze inbound WhatsApp messages",
  "description": "Dispara el an\u00e1lisis autom\u00e1tico cuando entra un nuevo mensaje de cliente en BitacoraWhatsApp.",
  "trigger": {
    "condition": "${ ((.trigger.data.direction == \"inbound\") and (.trigger.data.sender_type == \"customer\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "BitacoraWhatsApp"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "analyze_inbound_whatsapp_messages",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "analyzeConversation",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "analyzeConversation"
  }
}